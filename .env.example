# WARNING: Copy this file to .env and fill in ALL values before running Docker Compose.
# Never commit .env to version control.

# --- Database ---
POSTGRES_DB=power_asset_intelligence
POSTGRES_USER=power_asset
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_PORT=5432

# --- Backend API ---
APP_PORT=8080
SPRING_PROFILES_ACTIVE=docker
LOGGING_LEVEL_ROOT=INFO

# --- ML Service ---
ML_SERVICE_PORT=8000

# --- Kafka ---
KAFKA_IMAGE=bitnamilegacy/kafka:3.7.0
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=29092
KAFKA_TELEMETRY_RAW_TOPIC=telemetry.raw.v1
KAFKA_TELEMETRY_DLT_TOPIC=telemetry.raw.v1.dlt

# --- Observability ---
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000
GRAFANA_USER=<CHANGE_ME>
GRAFANA_PASSWORD=<CHANGE_ME>

# --- Frontend ---
FRONTEND_PORT=3001
