# ─── Database ───
POSTGRES_DB=power_asset_intelligence
POSTGRES_USER=power_asset
POSTGRES_PASSWORD=change-me-secure-password

# ─── Kafka ───
KAFKA_IMAGE=bitnamilegacy/kafka:3.7.0
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=29092
KAFKA_TELEMETRY_RAW_TOPIC=telemetry.raw.v1
KAFKA_TELEMETRY_DLT_TOPIC=telemetry.raw.v1.dlt
KAFKA_TELEMETRY_CONSUMER_GROUP=power-asset-telemetry-ingestion
KAFKA_TELEMETRY_CONCURRENCY=3
KAFKA_TELEMETRY_SEND_TIMEOUT_MS=5000
KAFKA_TELEMETRY_RETRY_ATTEMPTS=3
KAFKA_TELEMETRY_RETRY_BACKOFF_MS=1000

# ─── Spring Boot ───
SPRING_PROFILES_ACTIVE=secured
LOGGING_LEVEL_ROOT=INFO

# ─── JWT Security ───
# Generate with: openssl rand -hex 32
SECURITY_JWT_SECRET=dev-secret-do-not-use-in-production-at-least-32-chars-long
SECURITY_JWT_EXPIRATION_MS=86400000
SECURITY_JWT_DEV_USERNAME=admin
SECURITY_JWT_DEV_PASSWORD=admin123

# ─── ML Service ───
ML_API_KEY=ml-dev-key-change-me
ML_BASE_URL=http://ml-service:8000
MODEL_VERSION=dev
GIT_SHA=unknown
BUILD_DATE=unknown

# ─── Monitoring ───
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
PROMETHEUS_PORT=9090
LOKI_PORT=3100

# ─── Port Mappings (only frontend is exposed) ───
FRONTEND_PORT=3001
